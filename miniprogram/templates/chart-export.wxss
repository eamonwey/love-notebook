.export-canvas { position: fixed; left: -2000px; top: 0; width: 700px; height: 460px; pointer-events: none; }
.export-mask { position: fixed; inset: 0; z-index: 10000; background: rgba(41,30,37,.58); display: flex; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box; }
.export-panel { width: 100%; max-width: 560px; max-height: 90vh; background: #fff; border-radius: 20px; padding: 18px; box-sizing: border-box; display: flex; flex-direction: column; }
.export-header { display: flex; justify-content: space-between; align-items: flex-start; flex-shrink: 0; }
.export-title { color: #453941; font-size: 18px; font-weight: 600; line-height: 36px; }
.export-caption { color: #8f8189; font-size: 12px; margin-top: 7px; }
.export-dismiss { width: 36px; height: 36px; line-height: 32px; text-align: center; color: #8f8189; font-size: 30px; flex-shrink: 0; }
.export-gallery { min-height: 90px; flex-shrink: 0; margin: 12px 0 16px; background: #fff; border: 1px solid #f1e8ed; border-radius: 8px; overflow: hidden; box-sizing: content-box; }
.export-preview-scroll { height: 100%; }
.export-preview { display: block; width: 100%; height: auto; }
.export-range { text-align: center; margin: 12px 0 18px; }
.export-actions { display: flex; gap: 12px; flex-shrink: 0; }
.export-button { flex: 1; margin: 0; padding: 0 8px; height: 46px; line-height: 46px; font-size: 14px; border-radius: 23px; font-weight: 500; }
.export-button::after { border: none; }
.export-primary { background: #e35c78; color: #fff; }
.export-secondary { background: #f9eaf0; color: #a03e57; }
.export-pressed { opacity: .75; }
.export-privacy { margin-top: 12px; text-align: center; font-size: 11px; color: #9a9096; }
@media (max-height: 450px) {
  .export-panel { padding: 20px; max-width: 760px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(230px, 1fr); column-gap: 20px; }
  .export-gallery { grid-column: 1; grid-row: 1 / 5; margin: 0; align-self: center; }
  .export-header, .export-range, .export-actions, .export-privacy { grid-column: 2; }
  .export-header { grid-row: 1; }
  .export-range { margin: 8px 0; text-align: left; line-height: 1.7; }
  .export-actions { flex-direction: column; gap: 8px; }
  .export-title { font-size: 18px; }
  .export-privacy { margin-top: 6px; }
  .export-button { height: 38px; line-height: 38px; flex: none; width: 100%; }
}
