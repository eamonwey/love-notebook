@import "../../templates/chart-export.wxss";
page { background: #fff; }
.fullscreen-page { position: fixed; inset: 0; box-sizing: border-box; display: flex; flex-direction: column; background: #fff; color: #453941; font-size: 14px; }
.screen-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 40px; flex-shrink: 0; }
.screen-heading { font-size: 19px; font-weight: 600; }
.screen-actions { display: flex; gap: 20px; align-items: center; }
.screen-action { color: #c64d6a; padding: 10px 0; }
.screen-exit { padding: 9px 16px; background: #f8eef2; color: #a03e57; border-radius: 20px; }
.screen-chart { flex: 1; min-height: 100px; position: relative; overflow: hidden; }
.screen-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.screen-scroll { position: relative; width: 100%; height: 100%; z-index: 1; }
.screen-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 12px; color: #9a9096; min-height: 28px; flex-shrink: 0; }
.screen-legend { display: flex; gap: 20px; }
.legend-me { color: #ff6b81; }.legend-ta { color: #5b8def; }.legend-event { color: #c78b00; }
.screen-empty { flex: 1; display: flex; align-items: center; justify-content: center; color: #9a9096; }
.event-mask { position: fixed; inset: 0; z-index: 9000; display: flex; align-items: center; justify-content: center; background: rgba(41,30,37,.58); padding: 16px; box-sizing: border-box; }
.event-dialog { width: 560px; max-width: 85vw; max-height: 80vh; border-radius: 18px; background: #fff; padding: 20px 24px; box-sizing: border-box; display: flex; flex-direction: column; }
.event-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; flex-shrink: 0; }
.event-title { font-size: 19px; font-weight: 600; }.event-scores { color: #9a9096; margin-top: 6px; font-size: 12px; }
.event-close { font-size: 30px; color: #9a9096; line-height: 30px; width: 36px; height: 36px; text-align: center; }
.event-scroll { height: 45vh; min-height: 60px; flex-shrink: 1; }
.event-record { padding: 14px 0; border-top: 1px solid #f1e8ed; }
.event-meta { display: flex; justify-content: space-between; gap: 12px; color: #9a9096; font-size: 12px; }
.event-reason { margin-top: 8px; line-height: 1.7; font-size: 15px; color: #453941; white-space: pre-wrap; word-break: break-all; }
.event-state { padding: 14px 0; color: #c64d6a; text-align: center; font-size: 13px; }
@media (max-width: 550px) { .screen-actions { gap: 12px; }.screen-footer { font-size: 10px; }.screen-legend { gap: 10px; } }
