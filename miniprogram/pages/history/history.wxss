@import "../../templates/chart-export.wxss";
.chart {
  width: 100%;
  height: 440rpx;
  margin-top: 16rpx;
}
.chart-toolbar { margin-top: 12rpx; display: flex; justify-content: flex-end; align-items: center; gap: 28rpx; }
.fullscreen-entry { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 0; }
.fullscreen-icon { width: 24rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 3rpx; }
.chart-window { height: 440rpx; position: relative; margin-top: 16rpx; overflow: hidden; }
.chart-fixed { position: absolute; top: 0; left: 0; margin-top: 0; pointer-events: none; }
.chart-scroll { position: relative; width: 100%; height: 440rpx; z-index: 1; background: transparent; }

.legend {
  margin: 10rpx 0 16rpx;
}

.legend-item {
  font-size: 24rpx;
  color: #7c7570;
  margin-right: 30rpx;
  display: flex;
  align-items: center;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-me {
  background: #ff6b81;
}

.dot-ta {
  background: #5b8def;
}

.dot-ev {
  background: #ffb300;
}

.ev-item {
  border-top: 2rpx solid #f6ecea;
  padding: 16rpx 0 6rpx;
  margin-top: 10rpx;
}

.ev-title {
  font-size: 26rpx;
  color: #5f5854;
}

.ev-reason {
  font-size: 28rpx;
  margin-top: 6rpx;
}

.tl-group {
  border-top: 2rpx solid #f6ecea;
  padding-top: 16rpx;
  margin-top: 16rpx;
}

.tl-group:first-of-type {
  border-top: none;
  padding-top: 4rpx;
  margin-top: 0;
}

.tl-head {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff6b81;
  margin-bottom: 4rpx;
}

.tl-group .ev-item:first-of-type {
  border-top: none;
  margin-top: 4rpx;
}

.form-row {
  margin-top: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: #9a938f;
  width: 130rpx;
}

.picker-value {
  background: #fff8f6;
  border-radius: 12rpx;
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
