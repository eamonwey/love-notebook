.chart {
  width: 100%;
  height: 440rpx;
  margin-top: 16rpx;
}

.legend {
  margin: 10rpx 0 16rpx;
}

.legend-item {
  font-size: 24rpx;
  color: #7c7570;
  margin-right: 30rpx;
  display: flex;
  align-items: center;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-me {
  background: #ff6b81;
}

.dot-ta {
  background: #5b8def;
}

.dot-ev {
  background: #ffb300;
}

.ev-item {
  border-top: 2rpx solid #f6ecea;
  padding: 16rpx 0 6rpx;
  margin-top: 10rpx;
}

.ev-title {
  font-size: 26rpx;
  color: #5f5854;
}

.ev-reason {
  font-size: 28rpx;
  margin-top: 6rpx;
}

.form-row {
  margin-top: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: #9a938f;
  width: 130rpx;
}

.picker-value {
  background: #fff8f6;
  border-radius: 12rpx;
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
