<view class="page">
  <gift-hub />
  <view class="card" wx:if="{{fromShare}}">
    <view class="title">来交换这一期的心意</view>
    <view class="muted">这是一次聊天提醒，下方显示你当前配对的最新状态。旧卡片不会自动交换，也不会展示其他人的记录。</view>
    <button class="btn-plain mini" bindtap="goHome">回到首页</button>
  </view>
  <view class="card" wx:if="{{status && !status.cycle}}">
    <view class="title">请先完成双方配对</view>
    <button class="btn-primary" bindtap="goHome">前往首页</button>
  </view>
  <!-- 当前周期交换区 -->
  <view class="card" wx:if="{{status && status.cycle && status.cycle.status === 'exchanged'}}">
    <view class="title">第 {{status.cycle.index}} 期已交换</view>
    <view class="muted">下一期 {{nextOpenText}} 开放。现在仍可补充本期笔记和批注，新增笔记立即对TA可见。</view>
  </view>
  <view class="card" wx:if="{{status && status.cycle && status.cycle.status === 'active'}}">
    <view class="title">第 {{status.cycle.index}} 期交换</view>
    <view class="check-item" wx:if="{{status.myScore}}">✅ 我的打分已完成（{{status.myScore.score}} 分，对方暂时看不到）</view>
    <view class="check-item" wx:else>⬜ 我的打分未完成 <text class="link" bindtap="goScore">去打分</text></view>
    <view class="check-item" wx:if="{{status.partnerDone}}">✅ TA的打分已完成（分数交换后揭晓）</view>
    <view class="check-item" wx:else>⬜ TA的打分未完成，等待中…</view>

    <!-- 交换请求进行中 -->
    <block wx:if="{{status.exchangeRequest}}">
      <view class="req-banner" wx:if="{{status.exchangeRequest.from === status.me}}">
        <view class="req-text">💌 你已发起交换请求，等待TA同意</view>
        <button class="btn-plain mini" bindtap="onCancelRequest">撤回请求</button>
      </view>
      <view class="req-banner" wx:else>
        <view class="req-text">💌 {{reqFromName}} 想和你交换啦！</view>
        <view class="row">
          <button class="btn-primary mini {{status.bothScored ? '' : 'btn-disabled'}}" bindtap="onAgreeExchange">同意并交换</button>
          <button class="btn-plain mini" bindtap="onDeclineRequest">暂不</button>
        </view>
        <view class="muted" wx:if="{{!status.bothScored}}">同意前双方都需要完成打分。</view>
      </view>
    </block>

    <!-- 无请求时：统一走发起请求（自己必须先完成本期打分） -->
    <block wx:else>
      <view class="muted" wx:if="{{!status.myScore}}">先完成本期打分，才能发起交换请求。</view>
      <view class="muted" wx:elif="{{status.bothScored}}">双方都完成了打分。发起请求，TA同意后即可交换。</view>
      <view class="muted" wx:else>发起交换请求后，TA可在交换中心查看；TA打完分并同意后即可交换。</view>
      <button class="btn-primary {{status.myScore ? '' : 'btn-disabled'}}" bindtap="onRequestExchange">💌 发起交换请求</button>
    </block>

  </view>

  <view class="card" wx:if="{{status && status.cycle && status.cycle.status === 'active' && status.myScore}}">
    <view class="title">把提醒发到TA的微信</view>
    <view class="muted">手动选择聊天发送，不含分数和留言。分享不等于发起或同意交换。</view>
    <button class="btn-primary" open-type="share">分享给TA，提醒交换</button>
  </view>

  <!-- 已交换周期详情 -->
  <block wx:if="{{detail && detail.status === 'exchanged'}}">
    <view class="card">
      <view class="title">第 {{detail.index}} 期的交换结果</view>
      <view class="row score-compare">
        <view class="score-col">
          <view class="muted">{{myName}}</view>
          <view class="score-big">{{detail.my ? detail.my.score : '—'}}</view>
          <view class="comment-bubble" wx:if="{{detail.my && detail.my.comment}}">{{detail.my.comment}}</view>
        </view>
        <view class="vs">VS</view>
        <view class="score-col">
          <view class="muted">{{detail.partner.name}}</view>
          <view class="score-big partner">{{detail.partner.score == null ? '—' : detail.partner.score}}</view>
          <view class="comment-bubble" wx:if="{{detail.partner.comment}}">{{detail.partner.comment}}</view>
        </view>
      </view>
      <view class="muted" wx:if="{{detail.exchangedText}}">交换时间：{{detail.exchangedText}}</view>
    </view>

    <view class="card">
      <view class="title">本期的笔记与批注</view>
      <view class="muted" wx:if="{{detail.notesTruncated}}">本期记录较多，目前只显示最近 100 条。</view>
      <view class="empty-mini" wx:if="{{!detail.notes.length}}">
        <text class="muted">本期双方都没有留下笔记</text>
      </view>
      <view class="note-block {{focusNoteId === item.id ? 'note-block-focus' : ''}}"
        wx:for="{{detail.notes}}" wx:key="id" id="note-{{item.id}}">
        <view class="row-between note-head" bindtap="toggleNote" data-id="{{item.id}}">
          <view class="tag {{item.type === 'happy' ? 'tag-happy' : 'tag-unhappy'}}">
            {{item.type === 'happy' ? '😊' : '😞'}} {{item.authorName}}{{item.mine ? '（我）' : ''}}
          </view>
          <view class="muted">
            {{expanded[item.id] ? '收起 ▾' : '展开 ▸'}}
            <text wx:if="{{item.annotations.length}}"> 💬{{item.annotations.length}}</text>
          </view>
        </view>
        <view class="note-body" wx:if="{{expanded[item.id]}}">
          <view class="row-between">
            <view class="note-time">{{item.timeText}}</view>
            <button wx:if="{{item.mine}}" class="btn-plain mini" bindtap="onDeleteNote" data-id="{{item.id}}">删除笔记</button>
          </view>
          <view class="note-content">{{item.content}}</view>
          <view class="ann-item" wx:for="{{item.annotations}}" wx:for-item="ann" wx:key="id">
            <view class="row-between">
              <text class="ann-author">{{ann.authorName}}{{ann.mine ? '（我）' : ''}}：</text>
              <text class="ann-time">{{ann.timeText}}</text>
            </view>
            <view class="ann-content">{{ann.content}}</view>
            <button wx:if="{{ann.mine}}" class="btn-plain mini" bindtap="onDeleteAnnotation" data-id="{{item.id}}" data-annotation-id="{{ann.id}}">删除批注</button>
          </view>
          <view class="ann-input-row">
            <textarea class="ann-editor" placeholder="写点批注…（最多200字）" value="{{annDraft[item.id]}}"
              bindinput="onAnnInput" data-id="{{item.id}}" maxlength="200" cursor-spacing="32" />
            <view class="row-between ann-editor-actions">
              <text class="muted">{{annDraft[item.id] ? annDraft[item.id].length : 0}} / 200</text>
              <button class="btn-primary mini" bindtap="submitAnn" data-id="{{item.id}}">批注</button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
