.check-item {
  font-size: 28rpx;
  margin: 10rpx 0;
}

.score-compare {
  margin-top: 20rpx;
  justify-content: space-around;
}

.score-col {
  text-align: center;
  width: 40%;
}

.score-big {
  font-size: 88rpx;
  font-weight: 700;
  color: #ff6b81;
  line-height: 1.3;
}

.score-big.partner {
  color: #5b8def;
}

.vs {
  font-size: 28rpx;
  color: #d8b0b8;
  font-weight: 700;
}

.comment-bubble {
  background: #fff4f5;
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #7c7570;
  margin-top: 8rpx;
}

.note-block {
  border-top: 2rpx solid #f6ecea;
  padding: 20rpx 0;
}

.note-block:first-of-type {
  border-top: none;
}

.note-head {
  padding: 4rpx 0;
}

.note-body {
  background: #fff8f6;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 14rpx;
}

.note-content {
  font-size: 28rpx;
}

.ann-item {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #7c7570;
}

.ann-author {
  color: #ff6b81;
  font-weight: 600;
}

.ann-input-row {
  margin-top: 16rpx;
}

.req-banner {
  background: #fff4f5;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.req-text {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.plan-section {
  border-top: 2rpx solid #f6ecea;
  margin-top: 24rpx;
  padding-top: 20rpx;
}

.plan-title {
  font-size: 26rpx;
  color: #7c7570;
  font-weight: 600;
}

.plan-value {
  font-size: 30rpx;
  margin: 14rpx 0;
}
